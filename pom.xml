<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.2</version>
        <relativePath/>
    </parent>

    <groupId>com.castor.guloso</groupId>
    <artifactId>castor-guloso</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Castor Guloso</name>
    <description>Lunch order automation system — replacing manual notebooks with
        digital workflow. Part of the Castor Alimentar project.</description>

    <modules>
        <module>castor-guloso-core</module>
        <module>castor-guloso-customer</module>
        <module>castor-guloso-menu</module>
        <module>castor-guloso-order</module>
        <module>castor-guloso-whatsapp</module>
        <module>castor-guloso-web</module>
        <module>castor-guloso-app</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Dependency versions -->
        <vaadin.version>24.4.4</vaadin.version>
        <zxing.version>3.5.3</zxing.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Internal modules -->
            <dependency>
                <groupId>com.castor.guloso</groupId>
                <artifactId>castor-guloso-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.castor.guloso</groupId>
                <artifactId>castor-guloso-customer</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.castor.guloso</groupId>
                <artifactId>castor-guloso-menu</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.castor.guloso</groupId>
                <artifactId>castor-guloso-order</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.castor.guloso</groupId>
                <artifactId>castor-guloso-whatsapp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.castor.guloso</groupId>
                <artifactId>castor-guloso-web</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Vaadin BOM -->
            <dependency>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-bom</artifactId>
                <version>${vaadin.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ZXing QR Code -->
            <dependency>
                <groupId>com.google.zxing</groupId>
                <artifactId>core</artifactId>
                <version>${zxing.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.zxing</groupId>
                <artifactId>javase</artifactId>
                <version>${zxing.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
