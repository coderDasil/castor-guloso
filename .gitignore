# Castor Guloso — .gitignore

# Maven
target/
*.jar
*.war
*.class

# IDE
.idea/
*.iml
.vscode/
.project
.classpath
.settings
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Dev data
data/

# Environment
.env
.env.local
*.log

# Node (generated by Vaadin)
node/
node_modules/

# Vaadin generated (nested in module src paths)
**/frontend/generated/
**/vaadin-dev-server-settings.json
