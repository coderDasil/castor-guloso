<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.castor.guloso</groupId>
        <artifactId>castor-guloso</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>castor-guloso-whatsapp</artifactId>
    <name>Castor Guloso — WhatsApp Integration</name>
    <description>WhatsApp Business Cloud API client, webhook verification and
        processing, message template management, and outbound message sending.</description>

    <dependencies>
        <!-- Internal -->
        <dependency>
            <groupId>com.castor.guloso</groupId>
            <artifactId>castor-guloso-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.castor.guloso</groupId>
            <artifactId>castor-guloso-customer</artifactId>
        </dependency>
        <dependency>
            <groupId>com.castor.guloso</groupId>
            <artifactId>castor-guloso-order</artifactId>
        </dependency>

        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Web client for Meta API calls -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
